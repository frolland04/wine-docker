#!/bin/bash

# Common variables
# Root folder = SCRIPT_DIR
# Root folder for persistent data
readonly PERSIST_DIR="${SCRIPT_DIR}/persist"
# Local folder with scripts, mounted in the container
readonly BATCH_DIR="${PERSIST_DIR}/batch"
# Name of the .bat script to run (default)
readonly BATCH_NAME=${1:-test1.bat}
shift || true
# Local folder for the build download cache (not apt, persistent)
DOWNLOADS_DIR="${PERSIST_DIR}/downloads"
# Local folder for the Wine prefix (persistent)
WINEPREFIX_DIR="${PERSIST_DIR}/wine"
# Local folder for the user account running Wine (persistent)
WINEUSER_NAME=devel
WINEUSER_DIR="${PERSIST_DIR}/${WINEUSER_NAME}"

# Image being built
readonly IMAGE_NAME="wine-docker"
readonly IMAGE_VERSION=1

# Dedicated user ID
readonly USER_ID=$(id -u)
readonly USER_GROUP=$(id -g)
readonly USER_NAME=devel
readonly USER_HOME=/home/${USER_NAME}

# Dedicated folders in the container
CONTAINER_BATCH_DIR="/batch"
CONTAINER_WINE_DIR="/.wine"

# Use --pull --progress=plain as needed.
# Never use --no-cache here: these options also apply to the download
# cache stages (dl-import, dl-export), which then get an empty BuildKit
# cache (see Dockerfile header). To rebuild the image without cache, use
# --no-cache-filter image instead (note: all files are downloaded again).
DOCKER_BUILD_OPTS=(
    --pull
    --progress=plain
    "--network host"
)

# Provide custom arguments
DOCKER_BUILD_ARGS=(
    P_USER_UID="${USER_ID}"
    P_USER_GID="${USER_GROUP}"
    P_USER_NAME="${USER_NAME}"
    P_BATCH_DIR="${CONTAINER_BATCH_DIR}"
    P_WINEPREFIX="${CONTAINER_WINE_DIR}"
    HTTP_PROXY=${HTTP_PROXY:-""}
)

# Spawning a named container
readonly RANDOM_ID="$(tr -dc a-z0-9 </dev/urandom | head -c 8; echo)"
readonly CONTAINER_NAME="${IMAGE_NAME}-${RANDOM_ID}"

# Run options
DOCKER_RUN_OPTS=(
    -it
    --rm
    --privileged
    "--network host"
    --shm-size=2g
)

# Provide custom environment variables
DOCKER_RUN_ENV_ARGS=(
    DISPLAY=:0
)

# Provide custom bind mounts
DOCKER_RUN_BIND_ARGS=(
    "${BATCH_DIR}":"${CONTAINER_BATCH_DIR}"
    "${WINEUSER_DIR}":"${USER_HOME}"
    "${WINEPREFIX_DIR}":"${CONTAINER_WINE_DIR}"
)

# Provide binds to sync from container to outside
DOCKER_SYNC_DIRS=(
    "${WINEUSER_DIR}":"${USER_HOME}"
)

# Provide custom entrypoint run args
DOCKER_RUN_ENTRYPOINT_ARGS=(
    "${CONTAINER_BATCH_DIR}/${BATCH_NAME}"
)