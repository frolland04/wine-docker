#!/bin/bash

# Here are special variables, usable at the 'build' stage

# Persistent download cache (not for apt), shared with the build
# by the named context "dl-context" and a BuildKit cache (see Dockerfile)
DOWNLOADS_DIR="${DOWNLOADS_DIR:-${SCRIPT_DIR}/persist/downloads}"

# dl_build <target> <tag> [docker build args...]: build a download cache stage.
# P_TIMESTAMP changes on each call: the stage is always re-run.
function dl_build()
{
    local target=$1
    local tag=$2
    shift 2
    docker build \
        "${BUILD_OPTS[@]}" \
        "${BUILD_ARGS[@]}" \
        --build-context dl-context="${DOWNLOADS_DIR}" \
        --target "${target}" \
        --build-arg P_TIMESTAMP="${tag}-$(date +%s%N)" \
        "$@" \
        ./files
}

# Called before the main build: "persist/downloads" => BuildKit cache
function build_hook()
{
    mkdir -p "${DOWNLOADS_DIR}"
    echo "[downloads] Import ${DOWNLOADS_DIR} => build cache ..."
    dl_build dl-import import
}

# Called after the main build: BuildKit cache => "persist/downloads"
function build_hook_post()
{
    echo "[downloads] Export build cache => ${DOWNLOADS_DIR} ..."
    dl_build dl-export export --output type=local,dest="${DOWNLOADS_DIR}"
}
